rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.uid == 'oVRpJs75q3erE4XZeI7oHl0dtVs1';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeamMember(ownerUid, teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(ownerUid)/teams/$(teamId)/members/$(request.auth.uid));
    }

    function memberRole(ownerUid, teamId) {
      return get(/databases/$(database)/documents/users/$(ownerUid)/teams/$(teamId)/members/$(request.auth.uid)).data.role;
    }

    function canReadTeam(ownerUid, teamId) {
      return isAdmin() || isOwner(ownerUid) || isTeamMember(ownerUid, teamId);
    }

    function canWriteTeam(ownerUid, teamId) {
      return isAdmin() ||
        isOwner(ownerUid) ||
        (isTeamMember(ownerUid, teamId) && memberRole(ownerUid, teamId) == 'editor');
    }

    function ownsInviteCode(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/inviteCodes/$(teamId)) &&
        get(/databases/$(database)/documents/inviteCodes/$(teamId)).data.ownerUid == request.auth.uid;
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      match /devices/{deviceId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }

      match /myTeams/{docId} {
        allow read, create, update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin() || isOwner(userId) || ownsInviteCode(docId);
      }

      match /teams/{teamId} {
        allow read: if canReadTeam(userId, teamId);
        allow create, update, delete: if isAdmin() || isOwner(userId);

        match /players/{docId} {
          allow read: if canReadTeam(userId, teamId);
          allow write: if canWriteTeam(userId, teamId);
        }

        match /matches/{docId} {
          allow read: if canReadTeam(userId, teamId);
          allow write: if canWriteTeam(userId, teamId);
        }

        match /training/{docId} {
          allow read: if canReadTeam(userId, teamId);
          allow write: if canWriteTeam(userId, teamId);
        }

        match /members/{memberUid} {
          allow read: if canReadTeam(userId, teamId);
          allow create: if isAdmin() ||
            isOwner(userId) ||
            (isSignedIn() &&
              request.auth.uid == memberUid &&
              request.resource.data.uid == request.auth.uid &&
              request.resource.data.inviteCode == teamId);
          allow update: if isAdmin() ||
            isOwner(userId) ||
            (isSignedIn() &&
              request.auth.uid == memberUid &&
              request.resource.data.uid == request.auth.uid);
          allow delete: if isAdmin() || isOwner(userId) || request.auth.uid == memberUid;
        }

        match /photos/{photoId} {
          allow read: if canReadTeam(userId, teamId);
          allow create, update, delete: if canReadTeam(userId, teamId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
